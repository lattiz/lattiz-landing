# Copy to .env.local for development. Server-only: never prefix with NEXT_PUBLIC_.

# REQUIRED. Base URL of the Lattiz API (no trailing slash needed; it is stripped).
# Used at build/ISR time by /templates (GET /public/templates). The build fails if missing.
LATTIZ_API_URL=https://api.lattiz.app

# Optional. Every template previewUrl must be https and on this origin; others are dropped.
TEMPLATE_PREVIEWS_ORIGIN=https://templates.lattiz.app
