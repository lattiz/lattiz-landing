# Copy to .env.local for development. Server-only: never prefix with NEXT_PUBLIC_.

# REQUIRED. Base URL of the Lattiz API (no trailing slash needed; it is stripped).
# Used at build/ISR time by /templates (GET /public/templates). The build fails if missing.
LATTIZ_API_URL=https://api.lattiz.app

# Optional. Every template previewUrl must be https and on this origin; others are dropped.
TEMPLATE_PREVIEWS_ORIGIN=https://templates.lattiz.app

# Optional. Analytics and advertising tags load only after cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-NM1CKCEL9V
NEXT_PUBLIC_GTM_ID=GTM-WVQNZ4BC
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
# Optional label appended to the conversion ID (for example: AW-123456789/AbCdEf).
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Optional. Content managed in Sanity (FAQs, plans, legal texts). Server-only.
# Without these the site serves the content bundled in the repo.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Viewer token of the project (the dataset is private).
SANITY_API_READ_TOKEN=
# Optional. Shared secret of the Sanity webhook that calls POST /api/revalidate after a publish.
SANITY_REVALIDATE_SECRET=

# Optional. Public base URL of the Lattiz API for the Latti AI chat (POST /chat).
# The chat button is hidden when it is not set.
NEXT_PUBLIC_LATTIZ_API_URL=
